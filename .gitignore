# VSCode C/C++ extension IntelliSense browsing database -- a local cache regenerated
# automatically, not source. It has previously grown past 1GB and blocked pushes.
.vscode/browse.vc.db*

# Generated by setup.sh / colcon build. Top-level colcon artifacts:
/build/
/install/
/log/

# CMake-generated artifacts inside each legacy planner package's build/ directory (see
# setup.sh). Parameter_Files/ under each one IS tracked (runtime config), so these ignore
# specific generated names/patterns rather than the whole build/ directory.
tactical_ugv_autonomous_stack/src/*/build/CMakeCache.txt
tactical_ugv_autonomous_stack/src/*/build/CMakeFiles/
tactical_ugv_autonomous_stack/src/*/build/Makefile
tactical_ugv_autonomous_stack/src/*/build/cmake_install.cmake
tactical_ugv_autonomous_stack/src/goal_generation/build/goal_generation
tactical_ugv_autonomous_stack/src/path_planner/build/path_planner
tactical_ugv_autonomous_stack/src/trajectory_planner/build/fmpc_uncut
tactical_ugv_autonomous_stack/src/constraint_generation/build/constraint_generation
