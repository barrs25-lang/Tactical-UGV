                <mxCell id="compute_rpt" value="&lt;b&gt;compute_roll_pitch_thrust_for_λ_and_g_barrier()&lt;/b&gt;&lt;br/&gt;RK4 integration over T steps&lt;br/&gt;Γ [3×3] = compute_Gamma(φ,θ,ψ)&lt;br/&gt;G_inv [4×4] = get_Ginv_k(φ,θ,ψ,u1)&lt;br/&gt;f [4×1] = get_f_k(...)&lt;br/&gt;ζ_k = G_inv · (-f + v_k) [4×T]&lt;br/&gt;u_k [4×T], T_k = -M·u_k [4×T]&lt;br/&gt;φ_k [T×1], θ_k [T×1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
